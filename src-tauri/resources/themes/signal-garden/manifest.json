{
  "schemaVersion": 1,
  "id": "signal-garden",
  "name": "Signal Garden",
  "description": "A sandboxed code theme that grows a strange luminous garden from your voice.",
  "author": "LocalDictate",
  "preview": "preview.png",
  "overlay": {
    "renderer": "web",
    "width": 460,
    "height": 240,
    "anchor": "bottom-center",
